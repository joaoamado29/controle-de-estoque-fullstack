# ==============================================================================
# Stoky - Variáveis de Ambiente de Exemplo
# ==============================================================================
# Copie este arquivo para .env e ajuste os valores se necessário:
# cp .env.example .env (Linux/Mac) ou Copy-Item .env.example .env (PowerShell)

# Conexão Assíncrona com PostgreSQL (Utilizada pela aplicação FastAPI e SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://estoque_user:estoque_pass@localhost:5432/estoque_db

# Conexão Síncrona com PostgreSQL (Utilizada pelo Alembic para migrações DDL)
DATABASE_URL_SYNC=postgresql+psycopg2://estoque_user:estoque_pass@localhost:5432/estoque_db
